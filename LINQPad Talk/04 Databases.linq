<Query Kind="Program">
  <Connection>
    <ID>24ef3593-550c-40fe-8c3a-644bdd310565</ID>
    <NamingServiceVersion>3</NamingServiceVersion>
    <Persist>true</Persist>
    <Driver Assembly="(internal)" PublicKeyToken="no-strong-name">LINQPad.Drivers.EFCore.DynamicDriver</Driver>
    <AllowDateOnlyTimeOnly>true</AllowDateOnlyTimeOnly>
    <Server>(localdb)\MSSQLLocalDB</Server>
    <SqlSecurity>true</SqlSecurity>
    <Database>LowClearanceDb</Database>
    <DriverData>
      <EncryptSqlTraffic>True</EncryptSqlTraffic>
      <PreserveNumeric1>True</PreserveNumeric1>
      <EFProvider>Microsoft.EntityFrameworkCore.SqlServer</EFProvider>
      <EnableSpatialTypes>true</EnableSpatialTypes>
      <ExtraCxOptions>Integrated Security=true</ExtraCxOptions>
    </DriverData>
  </Connection>
</Query>

#load "SlideKit.linq"

//  ═══ SLIDE 4 · DATABASES ═══ budget 4:00 ═══
//
//  ⚠ THIS SLIDE NEEDS PREP. Do not wing it. Checklist at the bottom.
//
//  THE LIVE BIT (do it in a separate, already-connected tab):
//    1. Show the connection tree, bottom-left. Expand a table.
//    2. Type  Customers.Take(100)  and F5. No DbContext. No scaffolding.
//    3. Type  Orders.Select(o => o.Customer.Name)  — nav properties, already wired.
//    4. ★ Click the SQL tab under the results. THIS IS THE MOMENT. ★
//       "That's the generated SQL, live, as you type the LINQ. It is the best
//        LINQ teaching tool that exists and it's been there since 2007."
//    5. Ctrl+Shift+G for editable data grids.

void Main()
{
    Slide("Databases", "no EF, no scaffolding, no connection string in appsettings");

    Points(
        "Add a connection (bottom-left) → pick a table → `Customers.Take(100)` → F5.",
        "**Schema lives in IntelliSense.** Navigation properties are pre-wired.",
        "**`Alt+Q` → the SQL panel**: the generated SQL, live, as you type the LINQ.",
        "`Ctrl+Shift+G` → editable data grids. `Ctrl+Shift+L` → convert existing SQL *to* LINQ.",
        "Works against SQL Server, PostgreSQL, SQLite, MySQL, Oracle, Azure, and more.");

    // --- The connection-free half: exporting is an API, not a menu item ------
    var sales = Enumerable.Range(1, 40).Select(i => new
    {
        Month   = new DateTime(2025, 1, 1).AddMonths(i % 12),
        Region  = new[] { "APAC", "EMEA", "AMER" }[i % 3],
        Revenue = 10_000 + (i * 137 % 9_000),
    }).ToList();

    sales.Dump("Try the ⊞ grid toggle and the ⋯ export menu on this table");

    Util.ToCsvString(sales.Take(5)).Dump("Util.ToCsvString");

    // Real multi-sheet .xlsx. No Excel installed, no ClosedXML, no NuGet.
    var xlsxPath = Path.Combine(Path.GetTempPath(), "linqpad-demo.xlsx");
    sales.ToSpreadsheet("Sales")
         .AddSheet(sales.GroupBy(s => s.Region)
                        .Select(g => new { Region = g.Key, Total = g.Sum(s => s.Revenue) }), "Summary")
         .Save(xlsxPath);

    // SAY: "Two sheets, native xlsx, no Excel, no package." — then click it open.
    new Hyperlinq(xlsxPath, $"→ open {Path.GetFileName(xlsxPath)}").Dump("Written to disk");

    Meme("", "", "", Vince);

    Nav(4, "Other People's Code", "4:00");
}

