<Query Kind="Program">
  <Namespace>System.Threading.Tasks</Namespace>
</Query>

#load "SlideKit.linq"

//  ═══ SLIDE 8 · SCRIPTING ═══ budget 3:00 ═══
//
//  SAY: "Why am I writing glue code in a language I only ever use for glue code,
//        and therefore relearn from scratch every single quarter?"
//
//  DO : Point at the top of this file — `#load "SlideKit.linq"`. Every slide in
//       this deck shares one helper file. That's the reuse story, live.

async Task Main()
{
    Slide("Scripting", "in a language you actually know");

    Meme("Writing PowerShell once a quarter", "Relearning PowerShell once a quarter", "", BatmanThinking);

    // Shelling out is a one-liner, and the output comes back as strings:
    Util.Cmd("dotnet", "--version", quiet: true).FirstOrDefault()
        .Dump("Util.Cmd(\"dotnet\", \"--version\")");

    // …so you can pipe real tools straight into LINQ. THIS is the point.
    // SAY: "Shell out, then query the result with LINQ and real types. Try that in bash."
    Util.Cmd("dotnet", "--list-sdks", quiet: true)
        .Select(line => line.Split(" [", StringSplitOptions.TrimEntries))
        .Where(parts => parts.Length == 2)
        .Select(parts => new { Version = parts[0], Path = parts[1].TrimEnd(']') })
        .Dump("Shell output → strongly-typed LINQ");
    
    

    var bar = new Util.ProgressBar("Progress").Dump("Progress bar example");
    _ = Task.Run(async () =>
    {
        Random r = new Random();
        var verbs = new [] {
            "Cogitating...",
            "Thinking...",
            "Thumbtwiddling...",
            "Reticulating Splines...",
            "Dilly-dallying...",
            "Procrastinating...",
            "Drinking tea...",
        };
        int captionIndex = 0;
        bar.Caption = verbs.ElementAt(captionIndex);
        while (!ScriptCancelToken.IsCancellationRequested)
        {
            for (int i = 0; i <= 100; i += 2)
            {
                bar.Percent = i;
                if (i % r.Next(25,35) == 0)
                {
                    int n = captionIndex;
                    while (n == captionIndex)
                        n = r.Next(verbs.Length);
                    captionIndex = (captionIndex + 1) % verbs.Length;
                    bar.Caption = verbs.ElementAt(captionIndex);
                }
                await Task.Delay(250);
            }
            await Task.Delay(1);
        }
    }, ScriptCancelToken);

    Points(
        "`Util.Cmd` (plus `Util.Bash` / `Util.Zsh` on macOS) · `Util.Run` to call one script from another.",
        "**`LPRun8.exe myscript.linq`** — headless, scheduled-task friendly, real exit codes.",
        "`Util.GetPassword` / `SetPassword` → the **OS keychain**, so no credentials in the file.",
        "`Util.SaveString` / `LoadString` for state between runs · `#LINQPad admin` for elevation.",
        "**`#load \"shared.linq\"`** + the **My Extensions** script (`Ctrl+Shift+Y`) = a personal stdlib everywhere.",
        "NuGet is one line: `#:package Humanizer@*`. No project, no restore dance.");

    Nav(8, "Tests & Benchmarks", TimeSpan.FromMinutes(3));
}
const string BatmanThinking = """
data:image/gif;base64,
""";
