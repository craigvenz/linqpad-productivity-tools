<Query Kind="Program" />

#load "SlideKit.linq"

//  ═══ SLIDE 1 · THE THESIS ═══ budget 2:00 ═══
//
//  DO FIRST (the best 15 seconds of the talk):
//    Press Ctrl+1 to switch this tab to "C# Expression".
//    Type:   DateTime.Now.AddDays(90)
//    Press F5. Done. No project, no Main, no build.
//    Press Ctrl+3 to come back to Program mode, then F5 for the rest.
//
//  SAY: "The unit of work in .NET is a *project*. That's the bug.
//        LINQPad's unit of work is an *expression*. Everything else
//        in this talk is a consequence of that one decision."

void Main()
{
    Slide("The Unit of Work");

    Points(
        "To run three lines of C# the 'normal' way: `dotnet new console`, restore, a `Program.cs`, a `Main`, a build…",
        "**LINQPad's unit of work is an expression.** Not a project. Not a class. An expression.",
        "That difference *is* the talk. Everything else follows from it.");

    Meme("Ten seconds of curiosity", "Forty seconds of MSBuild", "", Skeleton);

    Util.Markdown("""
        | Mode | You write | Good for |
        |---|---|---|
        | **C# Expression** `Ctrl+1` | `DateTime.Now.AddDays(90)` | one-liners, "what does this return?" |
        | **C# Statements** `Ctrl+2` | top-level statements | most scratch work |
        | **C# Program** `Ctrl+3` | `void Main()` + types | real scripts (like this deck) |
        """).Dump("Pick your ceremony level");

    // SAY: "And it's not a toy interpreter. Full Roslyn, current .NET, real IL."
    new
    {
        Runtime = Environment.Version.ToString(),
        Proof = "Real compiler. Click the IL tab under the results if you don't believe me."
    }.Dump("Receipts");

    Nav(1, "Dump() is not ToString()", TimeSpan.FromMinutes(2));
}
const string Skeleton = """
data:image/jpeg;base64,
""";