void Main()
{
    Slide("DX Tools for Fun and Profit<br/>LINQPad", "20 years of features in 30 minutes · hold on");

    Meme("", "", "", MemeImage);

    Points(
        "I've used LINQPad since **2009**. Back then it was a LINQ scratchpad.",
        "It is now: a REPL, a DB client, a decompiler, a charting library, a UI toolkit, a shell, and an AI harness.",
        "**Every single thing in this talk runs in the copy you can install.**");

    Nav(0, "The Unit of Work", TimeSpan.FromMinutes(1));
}
